    private async Task<Sudoku?> GetDailyLevel(string difficulte)
    {
        var today = DateTime.Today;

        return await context.Sudoku

            .Where(s => s.Date >= today && s.Date < today.AddDays(1) && s.Difficulte == difficulte)

            .Select(s => s)

            .FirstOrDefaultAsync();

    }

