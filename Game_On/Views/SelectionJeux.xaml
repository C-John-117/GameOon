<UserControl x:Class="Game_On.Views.SelectionJeux"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Game_On.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C2C2C" Padding="20,15" Margin="0,10,0,15">
            <TextBlock x:Name="txtPseudo" 
                       Text="Pseudo : " 
                       FontSize="18" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PanelJeux" Margin="20"/>
        </ScrollViewer>
    </Grid>
</UserControl>
