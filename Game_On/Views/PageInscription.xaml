<UserControl x:Class="Game_On.Views.PageInscription"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Game_On.Views"
             xmlns:viewmodel="clr-namespace:Game_On.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodel:UtilisateurVM}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="AliceBlue">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="195"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Margin="10" Content="Nom:" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="nom" Grid.Row="0" Grid.Column="1" Width="175" Margin="10" 
                     Text="{Binding NomUtilisateur}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding ErreurNom}" Grid.Row="1" Grid.Column="1" Width="175" 
                       Margin="10,0,10,5" Foreground="Red" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </Grid>


        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="195"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Margin="10" Content="Prenom:" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="prenom" Grid.Row="0" Grid.Column="1" Width="175" Margin="10" 
                     Text="{Binding PrenomUtilisateur}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding ErreurPrenom}" Grid.Row="1" Grid.Column="1" Width="175" 
                       Margin="10,0,10,5" Foreground="Red" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="195"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Margin="10" Content="Email:" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="Email" Grid.Row="0" Grid.Column="1" Width="175" Margin="10" 
                     Text="{Binding Email}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding ErreurEmail}" Grid.Row="1" Grid.Column="1" Width="175" 
                       Margin="10,0,10,5" Foreground="Red" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="195"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Margin="10" Content="Pseudo:" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="pseudo" Grid.Row="0" Grid.Column="1" Width="175" Margin="10" 
                     Text="{Binding Pseudo}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding ErreurPseudo}" Grid.Row="1" Grid.Column="1" Width="175" 
                       Margin="10,0,10,5" Foreground="Red" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="195"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Margin="10" Content="Mot de passe:" FontSize="15" VerticalAlignment="Center"/>
            <PasswordBox x:Name="password" Grid.Row="0" Grid.Column="1" Width="175" Margin="10" 
                         PasswordChanged="Pwd_PasswordChanged" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding ErreurMotDePasse}" Grid.Row="1" Grid.Column="1" Width="175" 
                       Margin="10,0,10,5" Foreground="Red" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Click="btn_retour_Click" Content="Retour" x:Name="btn_retour" Grid.Column="0" Height="30" Margin="10,0"/>
            <Button Click="btn_inscription_Click" Content="S'inscrire" x:Name="btn_inscription" Grid.Column="1" Height="30" Margin="10,0"/>
        </Grid>
    </Grid>
</UserControl>
