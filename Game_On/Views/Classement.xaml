<UserControl x:Class="Game_On.Views.Classement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Game_On.Views"
             xmlns:viewmodel="clr-namespace:Game_On.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             d:DataContext="{d:DesignInstance Type=viewmodel:GagnantVM}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundColor}">

    <Grid Margin="20">

        <i:Interaction.Triggers>
            <i:EventTrigger EventName="Loaded">
                <i:InvokeCommandAction Command="{Binding ChargerClassementSemaineAsyncCommand}" />
            </i:EventTrigger>
        </i:Interaction.Triggers>

        <!-- TabControl Material -->
        <TabControl
            materialDesign:ColorZoneAssist.Mode="PrimaryDark"
            FontSize="16"
            Margin="0,10">

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding RecalculerChartCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <!--  ONGLET ENTREPRISE  -->
            <TabItem Header="Entreprise" 
                     materialDesign:ColorZoneAssist.Mode="PrimaryMid">

                <Border Background="White" Padding="10" CornerRadius="8">

                    <TabControl ItemsSource="{Binding Entreprises}"
                                SelectedItem="{Binding EntrepriseSelecttioner}"
                                Background="Transparent"
                                Margin="10">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ChargerEntrepriseCommand}"
                                   CommandParameter="{Binding SelectedItem.Id, 
                                        RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <!-- Nom des onglets Entreprise -->
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NomEntreprise}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>

                        <!-- Contenu : TABLEAU MATERIAL -->
                        <TabControl.ContentTemplate>
                            <DataTemplate>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,10">
                                        <Button Content="⟵"
                                                Width="40"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.SemainePrecedenteAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <TextBlock Text="{Binding DataContext.DebutSemaine, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0" />
                                        <TextBlock Text=" - "
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding DataContext.FinSemaine, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Button Content="⟶"
                                                Width="40"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.SemaineSuivanteAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                IsEnabled="{Binding DataContext.PeutAllerSemaineSuivante, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding DataContext.ClassementsEntrepriseSemaine, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              Margin="10"
                                              RowHeight="40"
                                              materialDesign:DataGridAssist.CellPadding="12"
                                              materialDesign:DataGridAssist.ColumnHeaderPadding="10">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Id}"/>
                                            <DataGridTextColumn Header="Entreprise" Binding="{Binding Entreprise.NomEntreprise}"/>
                                            <DataGridTextColumn Header="Pseudo" Binding="{Binding Utilisateur.Pseudo}"/>
                                            <DataGridTextColumn Header="Score" Binding="{Binding Score}"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding DateClassement, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                        </DataGrid.Columns>

                                    </DataGrid>
                                </StackPanel>

                            </DataTemplate>
                        </TabControl.ContentTemplate>

                    </TabControl>
                </Border>
            </TabItem>

            <!--  ONGLET DÉPARTEMENT  -->
            <TabItem Header="Département" 
                     materialDesign:ColorZoneAssist.Mode="PrimaryMid">

                <Border Background="White" Padding="10" CornerRadius="8">

                    <TabControl ItemsSource="{Binding Departements}"
                                SelectedItem="{Binding DepartementSelecttionner}"
                                Background="Transparent"
                                Margin="10">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ChargerDepartementCommand}"
                                   CommandParameter="{Binding SelectedItem.Id, 
                                        RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NomDepartement}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>

                        <TabControl.ContentTemplate>
                            <DataTemplate>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,10">
                                        <Button Content="⟵"
                                                Width="40"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.SemainePrecedenteAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <TextBlock Text="{Binding DataContext.DebutSemaine, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0" />
                                        <TextBlock Text=" - "
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding DataContext.FinSemaine, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Button Content="⟶"
                                                Width="40"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.SemaineSuivanteAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                IsEnabled="{Binding DataContext.PeutAllerSemaineSuivante, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding DataContext.ClassementsDepartementSemaine, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              Margin="10"
                                              RowHeight="40"
                                              materialDesign:DataGridAssist.CellPadding="12"
                                              materialDesign:DataGridAssist.ColumnHeaderPadding="10">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Id}"/>
                                            <DataGridTextColumn Header="Département" Binding="{Binding Departement.NomDepartement}"/>
                                            <DataGridTextColumn Header="Entreprise" Binding="{Binding Entreprise.NomEntreprise}"/>
                                            <DataGridTextColumn Header="Pseudo" Binding="{Binding Utilisateur.Pseudo}"/>
                                            <DataGridTextColumn Header="Score" Binding="{Binding Score}"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding DateClassement, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                        </DataGrid.Columns>

                                    </DataGrid>
                                </StackPanel>

                            </DataTemplate>
                        </TabControl.ContentTemplate>

                    </TabControl>
                </Border>
            </TabItem>

            <TabItem Header="Dashboard classement"
         materialDesign:ColorZoneAssist.Mode="PrimaryMid">

                <Border Background="White"
            Padding="16"
            CornerRadius="10"
            SnapsToDevicePixels="True">

                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Titre + bouton -->
                            <RowDefinition Height="Auto"/>
                            <!-- Cartes KPI -->
                            <RowDefinition Height="*"/>
                            <!-- Chart -->
                        </Grid.RowDefinitions>

                        <!-- Ligne 1 : Titre + bouton refresh -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Dashboard des scores"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="DarkSlateBlue"/>

                                <TextBlock Text="Classement global et performance des entreprises"
                               FontSize="13"
                               Foreground="Gray"/>
                            </StackPanel>

                            <Button Content="Rafraîchir"
                        DockPanel.Dock="Right"
                        Command="{Binding RecalculerChartAsyncCommand}"
                        Margin="8,0,0,0" />
                        </DockPanel>

                        <!-- Ligne 2 : 3 cartes KPI -->
                        <UniformGrid Grid.Row="1"
                         Columns="3"
                         Margin="0,0,0,16"
                         HorizontalAlignment="Stretch">

                            <!-- Carte 1 : Top entreprise -->
                            <Border Background="#FFF5F5F5"
                        CornerRadius="8"
                        Padding="12"
                        Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Top entreprise"
                                   FontSize="13"
                                   Foreground="Gray" />
                                    <TextBlock Text="{Binding TopEntrepriseNom}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding TopEntrepriseScore, StringFormat='Score: {0}'}"
                                   FontSize="14"
                                   Foreground="DarkSlateBlue" />
                                </StackPanel>
                            </Border>

                            <!-- Carte 2 : Score moyen global -->
                            <Border Background="#FFF5F5F5"
                        CornerRadius="8"
                        Padding="12"
                        Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Score moyen global"
                                   FontSize="13"
                                   Foreground="Gray" />
                                    <TextBlock Text="{Binding ScoreMoyenGlobal, StringFormat='{}{0:F1}'}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />
                                    <TextBlock Text="Tous joueurs"
                                   FontSize="12"
                                   Foreground="DarkSlateBlue" />
                                </StackPanel>
                            </Border>

                            <!-- Carte 3 : Nombre total de joueurs -->
                            <Border Background="#FFF5F5F5"
                        CornerRadius="8"
                        Padding="12"
                        Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Nombre de joueurs"
                                   FontSize="13"
                                   Foreground="Gray" />
                                    <TextBlock Text="{Binding NombreTotalUtilisateurs}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />
                                    <TextBlock Text="Actifs dans le classement"
                                   FontSize="12"
                                   Foreground="DarkSlateBlue" />
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <!-- Ligne 3 : Chart -->
                        <Grid Grid.Row="2">
                            <lvc:CartesianChart Series="{Binding ChartVM.Series}"
                                    LegendLocation="Bottom"
                                    Background="Transparent"
                                    Hoverable="True"
                                    DataTooltip="{x:Null}">

                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Entreprises"
                                  Labels="{Binding ChartVM.EntrepriseNames}"
                                  LabelsRotation="15"
                                  FontSize="12">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>

                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Score moyen"
                                  FontSize="12">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>

                            </lvc:CartesianChart>
                        </Grid>

                    </Grid>

                </Border>

            </TabItem>
            
        </TabControl>

    </Grid>

</UserControl>
